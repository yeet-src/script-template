# Pinned versions for the vendored build toolchain. Sourced by the build
# and fetch scripts and by CI so every arch is built from identical inputs.

# LLVM/clang — built fully-static from source (see Dockerfile.clang). clang is
# the one tool we build rather than fetch, so consumers download the prebuilt
# binary from our release assets; CI fills these checksums after building.
# Empty until vendor.yml has published a build.
LLVM_VERSION=22.1.8
CLANG_SHA256_x86_64=
CLANG_SHA256_aarch64=

# Where a consumer (`yeet build`) fetches the prebuilt clang asset from when
# populating its local toolchain cache. Assets are version-addressed
# (clang-<arch>-llvm<version>) on a stable "toolchain" release, so older pins
# keep resolving their exact binary after a toolchain bump.
TOOLCHAIN_BASE_URL=https://github.com/yeet-src/script-template/releases/download/toolchain

# bpftool — official static release from libbpf/bpftool. The matching libbpf
# program headers (vendored under v/include/bpf) ride the same version; CI
# records the published headers-tarball checksum here.
BPFTOOL_VERSION=7.7.0
BPFTOOL_SHA256_amd64=09150596f09356b0ff632dd7f9856e0ea86bf96b269e9bc94278d9a9432a268c
BPFTOOL_SHA256_arm64=d68443d945c146080151eb215bebaa400294ab7ada22af4f5d0a940f5992b9d9
LIBBPF_HEADERS_SHA256=

# GNU make — the build driver. Built static from source (tiny, fast). Since
# make can't fetch itself, `yeet build` bootstraps it into the cache at the
# shell level before invoking it. CI records the per-arch checksums.
MAKE_VERSION=4.4.1
MAKE_SHA256_x86_64=
MAKE_SHA256_aarch64=

# esbuild — official static (Go) binary from the @esbuild/<platform> npm
# packages. Keep in sync with template/package.json's esbuild dependency.
ESBUILD_VERSION=0.28.1
ESBUILD_SHA256_amd64=9ed00ab5330c94386f3273eda99a1fb0e8f37cfd6cb5270e4ad2fe3527da3546
ESBUILD_SHA256_arm64=2145e9e686c95ee47c1181f83f272f0ff95820e52d7736fdcd9eeb106fd6456a

# Alpine base used for the musl-static clang build.
ALPINE_TAG=alpine:3.21
